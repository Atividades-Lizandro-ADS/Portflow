# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (usado pelo container postgres E pelo Django)
POSTGRES_DB=portflow
POSTGRES_USER=portflow
POSTGRES_PASSWORD=portflow
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000       # endpoint interno (Django → MinIO dentro do Docker)
MINIO_PUBLIC_URL=localhost:9000  # endpoint externo (browser → MinIO, para URLs de mídia)
MINIO_BUCKET_NAME=portflow-media
MINIO_USE_HTTPS=False

# CORS (origens permitidas para o frontend React)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
